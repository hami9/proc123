{
  "name": "proc123",
  "version": "0.0.0",
  "private": true,
  "description": "Universal e-commerce catalog scanner that exports import-ready product CSVs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "release:sync": "node scripts/release/sync-version.mjs",
    "release:check": "node scripts/release/sync-version.mjs --check",
    "release:dry-run": "npx semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
